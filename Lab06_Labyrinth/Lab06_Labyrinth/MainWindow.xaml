<Window x:Class="Lab06_Labyrinth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab06_Labyrinth"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10">
            <Label Content="Labyrinth" FontSize="24" HorizontalAlignment="Left" />
            <TextBlock x:Name="GoodieCounter" Text="Schnitzelsemmel: 0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="10,0,0,0" />
        </DockPanel>

        <ScrollViewer x:Name="Viewport" Grid.Row="1" Margin="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
            <Canvas Name="Spielfeld" Background="LightGray" />
        </ScrollViewer>
    </Grid>
</Window>
